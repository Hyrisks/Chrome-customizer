{
  "manifest_version": 3,
  "name": "Chrome Customizer",
  "version": "1.4",
  "description": "Customize Google and your new tab: backgrounds, slideshow, quick links, and a clock above the search bar.",
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/",
        "https://www.google.com/?*",
        "https://www.google.com/webhp*",
        "https://www.google.ca/",
        "https://www.google.ca/?*",
        "https://www.google.ca/webhp*"
      ],
      "js": [
        "shared.js",
        "quicklinks.js",
        "host.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "bg.html",
        "panel.html"
      ],
      "matches": [
        "https://www.google.com/*",
        "https://www.google.ca/*"
      ]
    }
  ]
}